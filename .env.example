# Modelo das variáveis. Este arquivo NÃO é lido automaticamente (o projeto não usa dotenv):
# fora da Vercel, exporte as variáveis no shell ou rode `node --env-file=.env server.js` (Node 20.6+);
# na Vercel, cadastre cada uma em Settings → Environment Variables (segredos como Sensitive).
# Nunca coloque valores reais neste arquivo nem em outro arquivo do repositório.
# OBRIGATÓRIA em produção: senha inicial da área do proprietário (12+ caracteres aleatórios).
# No primeiro acesso o painel exige trocá-la; depois disso ela deixa de funcionar.
ADMIN_PASSWORD=
# OBRIGATÓRIA em produção: chave para assinar a sessão (32+ caracteres; ex.: openssl rand -hex 32)
SESSION_SECRET=
# Criado automaticamente ao conectar um Blob Store ao projeto na Vercel (só no ambiente Production, marcado como Sensitive)
BLOB_READ_WRITE_TOKEN=
# Opcional: endereço oficial do site (canônico, sitemap, Open Graph). Sem ele, usa o domínio de produção da Vercel.
SITE_URL=
# Opcional: URL do Deploy Hook da Vercel (Settings → Git → Deploy Hooks, branch main). Liga o botão
# "publicar alterações no Google" do painel. Sensitive: quem tem a URL consegue disparar deploys.
DEPLOY_HOOK_URL=
# Opcional: segredo da republicação diária (crons do vercel.json; a Vercel envia "Authorization: Bearer <CRON_SECRET>").
# Só funciona junto com DEPLOY_HOOK_URL. 16+ caracteres aleatórios (ex.: openssl rand -hex 24).
CRON_SECRET=
# Só para hospedagem fora da Vercel (modo arquivos). npm start já usa NODE_ENV=production.
# Use o MESMO DATA_DIR no `npm run build` e no `npm start`: sem ele, o build lê ./data e publica o conteúdo padrão.
DATA_DIR=./data
PORT=3000
# Atrás de um proxy reverso (nginx etc.): 1 para usar o IP real do visitante no limite de tentativas
TRUST_PROXY=

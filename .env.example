# Senha inicial da área do proprietário (troque depois pelo painel)
ADMIN_PASSWORD=
# Chave longa e aleatória para assinar a sessão (ex.: openssl rand -hex 32)
SESSION_SECRET=
# Criado automaticamente ao conectar um Blob Store ao projeto na Vercel
BLOB_READ_WRITE_TOKEN=
# Só para hospedagem fora da Vercel (modo arquivos)
DATA_DIR=./data
PORT=3000

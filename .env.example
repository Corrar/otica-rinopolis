# OBRIGATÓRIA em produção: senha inicial da área do proprietário (12+ caracteres aleatórios).
# No primeiro acesso o painel exige trocá-la; depois disso ela deixa de funcionar.
ADMIN_PASSWORD=
# OBRIGATÓRIA em produção: chave para assinar a sessão (32+ caracteres; ex.: openssl rand -hex 32)
SESSION_SECRET=
# Criado automaticamente ao conectar um Blob Store ao projeto na Vercel (só no ambiente Production)
BLOB_READ_WRITE_TOKEN=
# Só para hospedagem fora da Vercel (modo arquivos). npm start já usa NODE_ENV=production.
DATA_DIR=./data
PORT=3000
# Atrás de um proxy reverso (nginx etc.): 1 para usar o IP real do visitante no limite de tentativas
TRUST_PROXY=
